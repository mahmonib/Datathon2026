# Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# HMAC tokenisation secret — any random string, keep private
HMAC_SECRET=change_me_before_deploy

# Solana settings
SOLANA_NETWORK=devnet
SOLANA_KEYPAIR_PATH=/app/keys/auditor-wallet.json

# Data & cache paths (defaults work inside Docker with volume mounts)
DATASET_PATH=/app/Datasets/Tangerine/data
CACHE_PATH=/app/cache

